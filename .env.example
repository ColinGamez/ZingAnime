# Database (Vercel will automatically set POSTGRES_PRISMA_URL with Supabase integration)
POSTGRES_PRISMA_URL="postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-generate-with-openssl-rand-base64-32"

# TMDB API (Free - Get it from https://www.themoviedb.org/settings/api)
TMDB_API_KEY="your-tmdb-api-key-here"